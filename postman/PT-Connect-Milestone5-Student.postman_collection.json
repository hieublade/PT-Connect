            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/users?role=STUDENT",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "users"],
              "query": [
                {
                  "key": "role",
                  "value": "STUDENT"
                }
              ]
            }
          }
        },
        {
          "name": "4.3 RBAC: Không gửi Bearer Token gọi API Ví -> 401 Unauthorized",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 401 Unauthorized\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/wallet",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "wallet"]
            }
          }
        },
        {
          "name": "4.4 RBAC: PT gọi API Mua Khóa của Student -> 403 Forbidden",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 403 Forbidden\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
