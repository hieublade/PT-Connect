        },
        {
          "name": "2.3 GET /api/v1/pt/courses - Xem danh sách khóa học",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Trả về danh sách dạng mảng\", function () {",
                  "    pm.expect(jsonData.data).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{ptToken}}"}],
            "url": {
              "raw": "{{baseUrl}}/api/v1/pt/courses",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "pt", "courses"]
            }
          }
        },
        {
          "name": "2.4 PUT /api/v1/pt/courses/:id - Đổi trạng thái sang INACTIVE",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Trạng thái đã chuyển sang INACTIVE\", function () {",
                  "    pm.expect(jsonData.data.status).to.eql(\"INACTIVE\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Authorization", "value": "Bearer {{ptToken}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Gói Giảm Mỡ Cấp Tốc 12 Buổi Postman\",\n  \"totalSessions\": 12,\n  \"validityDays\": 30,\n  \"basePrice\": 3600000.0,\n  \"status\": \"INACTIVE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/pt/courses/{{createdCourseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "pt", "courses", "{{createdCourseId}}"]
            }
          }
        }
      ]
    },
