              "raw": "{\n  \"title\": \"Khóa lỗi\",\n  \"totalSessions\": 0,\n  \"validityDays\": 30,\n  \"basePrice\": 1000000.0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/pt/courses",
