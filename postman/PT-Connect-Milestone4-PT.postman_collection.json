    {
      "name": "4. Admin - Phê duyệt Huấn luyện viên (Approval)",
      "item": [
        {
          "name": "4.1 GET /api/v1/admin/pt/pending - Danh sách PT chờ duyệt",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.length > 0) {",
                  "    pm.collectionVariables.set(\"pendingPtProfileId\", jsonData.data[0].id.toString());",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{adminToken}}"}],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/pt/pending",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "pt", "pending"]
            }
          }
        },
        {
          "name": "4.2 PUT /api/v1/admin/pt/:id/approve - Phê duyệt PT",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Trạng thái xác minh chuyển sang VERIFIED\", function () {",
                  "    pm.expect(jsonData.data.verificationStatus).to.eql(\"VERIFIED\");",
                  "    pm.expect(jsonData.data.userStatus).to.eql(\"ACTIVE\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{"key": "Authorization", "value": "Bearer {{adminToken}}"}],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/pt/{{pendingPtProfileId}}/approve",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "pt", "{{pendingPtProfileId}}", "approve"]
            }
          }
        },
        {
          "name": "4.3 PUT /api/v1/admin/pt/:id/reject - Từ chối duyệt PT",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Trạng thái xác minh chuyển sang REJECTED\", function () {",
                  "    pm.expect(jsonData.data.verificationStatus).to.eql(\"REJECTED\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{"key": "Authorization", "value": "Bearer {{adminToken}}"}],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/pt/{{pendingPtProfileId}}/reject",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "pt", "{{pendingPtProfileId}}", "reject"]
            }
          }
        }
      ]
    }
  ]
