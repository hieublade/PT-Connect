  "item": [
    {
      "name": "0. Đăng nhập lấy Token",
      "item": [
        {
          "name": "0.1 Đăng nhập PT (Lấy ptToken)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set(\"ptToken\", jsonData.data.token);",
                  "    console.log(\"Saved ptToken:\", jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"pt.hoangc@ptconnect.vn\",\n  \"password\": \"Password123@\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "0.2 Đăng nhập Admin (Lấy adminToken)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set(\"adminToken\", jsonData.data.token);",
                  "    console.log(\"Saved adminToken:\", jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@ptconnect.vn\",\n  \"password\": \"Password123@\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "1. PT - Hồ sơ cá nhân (Profile)",
      "item": [
        {
          "name": "1.1 GET /api/v1/pt/profile - Xem hồ sơ PT",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Có dữ liệu hồ sơ PT\", function () {",
                  "    pm.expect(jsonData.data).to.have.property('experienceYears');",
                  "    pm.expect(jsonData.data).to.have.property('availableLocations');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{ptToken}}"}],
            "url": {
              "raw": "{{baseUrl}}/api/v1/pt/profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "pt", "profile"]
            }
          }
        },
        {
          "name": "1.2 PUT /api/v1/pt/profile - Cập nhật hồ sơ thành công",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Cập nhật đúng số năm kinh nghiệm\", function () {",
                  "    pm.expect(jsonData.data.experienceYears).to.eql(6);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Authorization", "value": "Bearer {{ptToken}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bio\": \"HLV cử tạ và thể hình chuyên nghiệp 6 năm kinh nghiệm\",\n  \"experienceYears\": 6,\n  \"availableLocations\": \"Phòng Cali Cầu Giấy; FitZone Thanh Xuân\",\n  \"locationPricingNote\": \"Phụ thu 10% tại nhà học viên\",\n  \"certificateUrls\": \"[\\\"https://cdn.ptconnect.vn/certs/cert_hlv_cap1.pdf\\\"]\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/pt/profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "pt", "profile"]
            }
          }
        },
        {
          "name": "1.3 PUT /api/v1/pt/profile - Lỗi kinh nghiệm âm (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Authorization", "value": "Bearer {{ptToken}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bio\": \"Lỗi\",\n  \"experienceYears\": -5,\n  \"availableLocations\": \"Hà Nội\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/pt/profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "pt", "profile"]
            }
          }
        }
      ]
    },
    {
      "name": "2. PT - Quản lý Khóa học (Courses)",
      "item": [
