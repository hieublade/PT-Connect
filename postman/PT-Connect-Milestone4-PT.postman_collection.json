{
  "info": {
    "_postman_id": "d4e6f8a0-ptconnect-milestone4-pt",
    "name": "PT-Connect - Milestone 4 (PT Features & Admin Approval)",
    "description": "Collection kiểm thử trọn bộ API Milestone 4: Quản lý Hồ sơ PT, Khóa học (Courses), Khung giờ rảnh (Availability Slots) và Quản trị viên duyệt PT (Admin Approval). Phụ trách: Hiệu & Nhóm",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "ptToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "createdCourseId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "createdSlotId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "pendingPtProfileId",
      "value": "1",
