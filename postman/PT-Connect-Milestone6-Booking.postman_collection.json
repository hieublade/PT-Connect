    }
  ],
  "item": [
    {
      "name": "0. Đăng nhập lấy Token",
      "item": [
        {
          "name": "0.1 Đăng nhập Student (Lấy studentToken)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set(\"studentToken\", jsonData.data.token);",
                  "    console.log(\"Saved studentToken:\", jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student@ptconnect.com\",\n  \"password\": \"Password123@\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "0.2 Đăng nhập PT (Lấy ptToken)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set(\"ptToken\", jsonData.data.token);",
                  "    console.log(\"Saved ptToken:\", jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"pt@ptconnect.com\",\n  \"password\": \"Password123@\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "1. User Avatar (Nhiệm vụ Hiệu - M6)",
      "item": [
        {
          "name": "1.1 Cập nhật Avatar (PUT /api/v1/users/avatar)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Avatar URL updated successfully\", function () {",
                  "    pm.expect(jsonData.data.avatarUrl).to.include(\"avatar\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"avatarUrl\": \"https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=400\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/avatar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "avatar"
              ]
            }
          }
        },
        {
          "name": "1.2 Kiểm tra hồ sơ người dùng (GET /api/v1/auth/me)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Verify avatar_url is returned\", function () {",
                  "    pm.expect(jsonData.data.avatarUrl).to.not.be.null;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "me"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Học viên Đặt lịch (Student Booking)",
      "item": [
        {
          "name": "2.1 Lấy danh sách Slot rảnh của PT",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.length > 0) {",
                  "    pm.collectionVariables.set(\"targetSlotId\", jsonData.data[0].id);",
                  "    console.log(\"Saved targetSlotId:\", jsonData.data[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/pt/{{ptProfileId}}/slots?status=AVAILABLE",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "pt",
                "{{ptProfileId}}",
                "slots"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "AVAILABLE"
                }
              ]
            }
          }
        },
        {
          "name": "2.2 Lấy danh sách Khóa học đã mua của Học viên",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.length > 0) {",
                  "    pm.collectionVariables.set(\"targetEnrollmentId\", jsonData.data[0].id);",
                  "    console.log(\"Saved targetEnrollmentId:\", jsonData.data[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/enrollments/my-courses",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "enrollments",
                "my-courses"
              ]
            }
          }
        },
        {
          "name": "2.3 Đặt lịch tập theo Gói (PACKAGE Booking)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.id) {",
                  "    pm.collectionVariables.set(\"createdBookingId\", jsonData.data.id);",
                  "    console.log(\"Saved createdBookingId:\", jsonData.data.id);",
                  "}",
                  "pm.test(\"Booking is PENDING\", function () {",
                  "    pm.expect(jsonData.data.status).to.eql(\"PENDING\");",
                  "    pm.expect(jsonData.data.bookingType).to.eql(\"PACKAGE\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slotId\": {{targetSlotId}},\n  \"enrollmentId\": {{targetEnrollmentId}},\n  \"bookingType\": \"PACKAGE\",\n  \"studentNotes\": \"Yêu cầu tập trung cardio và squat\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "bookings"
              ]
            }
          }
        },
        {
          "name": "2.4 Đặt lịch tập Thử (TRIAL Booking)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Response code is 201 or 400 (if already trialed)\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([201, 400]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slotId\": {{targetSlotId}},\n  \"ptId\": {{ptProfileId}},\n  \"bookingType\": \"TRIAL\",\n  \"studentNotes\": \"Buổi tập thử đầu tiên\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "bookings"
              ]
            }
          }
        },
        {
          "name": "2.5 Xem Lịch của tôi (GET /api/v1/bookings/my-bookings)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"List of student bookings is returned\", function () {",
                  "    pm.expect(jsonData.data).to.be.an(\"array\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/bookings/my-bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "bookings",
                "my-bookings"
              ]
            }
          }
        },
        {
          "name": "2.6 Lọc Lịch của tôi theo trạng thái (status=PENDING)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/bookings/my-bookings?status=PENDING",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "bookings",
                "my-bookings"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "PENDING"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. PT Duyệt & Từ chối Booking (PT Flow)",
      "item": [
        {
          "name": "3.1 PT Xem danh sách Booking học viên gửi đến",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"List of PT bookings is returned\", function () {",
                  "    pm.expect(jsonData.data).to.be.an(\"array\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ptToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/pt/bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "pt",
                "bookings"
              ]
            }
          }
        },
        {
          "name": "3.2 PT Xác nhận Booking (CONFIRMED)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Response code is 200 or 400\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 400]);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.test(\"Status is CONFIRMED\", function () {",
                  "        pm.expect(jsonData.data.status).to.eql(\"CONFIRMED\");",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ptToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/pt/bookings/{{createdBookingId}}/confirm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "pt",
                "bookings",
                "{{createdBookingId}}",
                "confirm"
              ]
            }
          }
        },
        {
          "name": "3.3 PT Từ chối Booking kèm lý do (REJECT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Response code is 200 or 400\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 400]);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.test(\"Status is CANCELLED and session refunded\", function () {",
                  "        pm.expect(jsonData.data.status).to.eql(\"CANCELLED\");",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{ptToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Trùng lịch thi đấu đột xuất\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/pt/bookings/{{createdBookingId}}/reject",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "pt",
                "bookings",
                "{{createdBookingId}}",
                "reject"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. Kiểm thử Chống Trùng Lịch & Phân quyền",
      "item": [
        {
          "name": "4.1 Chống Trùng Lịch (Double-Booking cùng Slot)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Expected 409 Conflict or 400 Bad Request\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([400, 409]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slotId\": {{targetSlotId}},\n  \"enrollmentId\": {{targetEnrollmentId}},\n  \"bookingType\": \"PACKAGE\",\n  \"studentNotes\": \"Cố tình book trùng slot\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "bookings"
              ]
            }
          }
        },
        {
          "name": "4.2 Phân quyền: Học viên không được gọi API của PT",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 403 Forbidden\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/pt/bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "pt",
                "bookings"
              ]
            }
          }
        }
      ]
    }
