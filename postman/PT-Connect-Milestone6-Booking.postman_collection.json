{
  "info": {
    "_postman_id": "a6b7c8d9-ptconnect-milestone6-booking",
    "name": "PT-Connect - Milestone 6 (Booking Flow & User Avatar)",
    "description": "Collection kiểm thử trọn bộ API Milestone 6: Luồng Booking (PACKAGE, TRIAL), PESSIMISTIC_WRITE chống double-booking, PT duyệt/từ chối hoàn session + slot, và cập nhật Avatar người dùng.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
