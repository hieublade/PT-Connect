{
  "info": {
    "_postman_id": "b7c8d9e0-ptconnect-milestone7-attendance-cancel-review",
    "name": "PT-Connect - Milestone 7 (Attendance, Cancel Policy & Review)",
    "description": "Collection kiểm thử trọn bộ API Milestone 7: Điểm danh xác thực hai phía bằng mã OTP 6 số, Chính sách hủy lịch đa hình (CancellationPolicy) và Đánh giá nhận xét PT kích hoạt Trigger MySQL.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "studentToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "ptToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "bookingId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "ptId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "otpCode",
      "value": "123456",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Đăng nhập lấy Token",
      "item": [
        {
          "name": "0.1 Đăng nhập Student",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set(\"studentToken\", jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student.a@ptconnect.vn\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "0.2 Đăng nhập Huấn luyện viên (PT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set(\"ptToken\", jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"pt.hoangc@ptconnect.vn\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "1. Điểm danh hai phía bằng mã OTP (Milestone 7 - Huy)",
      "item": [
        {
          "name": "1.1 PT Mở phiên điểm danh & sinh mã OTP 6 số",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.otpCode) {",
                  "    pm.collectionVariables.set(\"otpCode\", jsonData.data.otpCode);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ptToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/attendance/{{bookingId}}/start",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "attendance", "{{bookingId}}", "start"]
            }
          }
        },
        {
          "name": "1.2 Học viên nhập mã OTP để xác nhận có mặt",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"otpCode\": \"{{otpCode}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/attendance/{{bookingId}}/student-checkin",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "attendance", "{{bookingId}}", "student-checkin"]
            }
          }
        },
        {
          "name": "1.3 Huấn luyện viên xác nhận hoàn tất buổi tập",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ptToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/attendance/{{bookingId}}/pt-confirm",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "attendance", "{{bookingId}}", "pt-confirm"]
            }
          }
        },
        {
          "name": "1.4 Huấn luyện viên đánh dấu học viên vắng mặt (ABSENT)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ptToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/attendance/{{bookingId}}/absent?reason=Học+viên+không+đến+tập",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "attendance", "{{bookingId}}", "absent"],
              "query": [
                {
                  "key": "reason",
                  "value": "Học+viên+không+đến+tập"
                }
              ]
            }
          }
        },
        {
          "name": "1.5 Xem trạng thái chi tiết điểm danh",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/attendance/{{bookingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "attendance", "{{bookingId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Hủy lịch & Chính sách bồi thường (Milestone 7 - Hưng & Thắng)",
      "item": [
        {
          "name": "2.1 Xem trước chính sách hủy lịch (Preview)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/bookings/{{bookingId}}/cancel-preview",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "bookings", "{{bookingId}}", "cancel-preview"]
            }
          }
        },
        {
          "name": "2.2 Học viên hủy ca tập",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Học viên bận việc công tác đột xuất\",\n  \"evidenceUrl\": null\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/bookings/{{bookingId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "bookings", "{{bookingId}}", "cancel"]
            }
          }
        },
        {
          "name": "2.3 Huấn luyện viên hủy ca tập",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ptToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Huấn luyện viên bị sốt cao cần nghỉ ngơi\",\n  \"evidenceUrl\": \"https://cdn.ptconnect.vn/evidence/sick_note.pdf\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/pt/bookings/{{bookingId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "pt", "bookings", "{{bookingId}}", "cancel"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Đánh giá nhận xét Huấn luyện viên & Trigger (Milestone 7 - Thành)",
      "item": [
        {
          "name": "3.1 Học viên gửi đánh giá cho ca tập COMPLETED",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookingId\": {{bookingId}},\n  \"rating\": 5,\n  \"comment\": \"Huấn luyện viên rất nhiệt tình, kỹ thuật chỉnh form Squat rất chuẩn!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/reviews",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "reviews"]
            }
          }
        },
        {
          "name": "3.2 Xem danh sách đánh giá của Huấn luyện viên (Kèm điểm Trigger tính)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/reviews/pt/{{ptId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "reviews", "pt", "{{ptId}}"]
            }
          }
        },
        {
          "name": "3.3 Học viên xem lại các đánh giá do mình đã viết",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/reviews/my",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "reviews", "my"]
            }
          }
        },
        {
          "name": "3.4 Xem đánh giá của một ca tập cụ thể",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/reviews/booking/{{bookingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "reviews", "booking", "{{bookingId}}"]
            }
          }
        }
      ]
    }
  ]
}
