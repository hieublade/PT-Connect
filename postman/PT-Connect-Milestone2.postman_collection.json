{
  "info": {
    "_postman_id": "a1f38db4-ptconnect-milestone2-users",
    "name": "PT-Connect - Milestone 2 (Database & User API)",
    "description": "Collection test kết nối Backend với MySQL Database qua API GET danh sách Users (Milestone 2 - PT Connect)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. GET /api/v1/users - Lấy danh sách tất cả Users (Test kết nối DB)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "users"
          ]
        },
        "description": "API lấy danh sách toàn bộ người dùng, chứng minh backend kết nối CSDL MySQL thành công và map Entity -> UserDTO (không lộ password)."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP Status 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Định dạng ApiResponse chuẩn (status=200, message, data là array)\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.status).to.eql(200);",
              "    pm.expect(jsonData.message).to.be.a('string');",
              "    pm.expect(jsonData.data).to.be.an('array');",
              "});",
              "",
              "pm.test(\"Bảo mật: UserDTO không chứa trường passwordHash\", function () {",
              "    var jsonData = pm.response.json();",
              "    if (jsonData.data && jsonData.data.length > 0) {",
              "        pm.expect(jsonData.data[0].passwordHash).to.be.undefined;",
              "        pm.expect(jsonData.data[0].email).to.be.a('string');",
              "    }",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2. GET /api/v1/users?role=STUDENT - Lọc danh sách Student",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/users?role=STUDENT",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "users"
          ],
          "query": [
            {
              "key": "role",
              "value": "STUDENT"
            }
          ]
        },
        "description": "Lấy danh sách người dùng theo vai trò STUDENT"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP Status 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Tất cả user trả về đều có role STUDENT\", function () {",
              "    var jsonData = pm.response.json();",
              "    jsonData.data.forEach(function(u) {",
              "        pm.expect(u.role).to.eql(\"STUDENT\");",
              "    });",
              "});"
            ]
          }
        }
      ]
    },
